#!/usr/bin/env python3
"""Open the local read-only task board for a registered project."""
import argparse
from contextlib import closing
import errno
import http.client
import os
from pathlib import Path
import sqlite3
import subprocess
import sys
import time
import webbrowser

from ltc_board import BoardServer, connect, database_key, select_project


def service_at(port, identity):
    """Return the PID of a matching board, or None when nothing is listening."""
    client = http.client.HTTPConnection('127.0.0.1', port, timeout=2)
    try:
        client.request('GET', '/health')
        response = client.getresponse()
        if response.status == 200 and response.getheader('X-LTC-Board') == identity:
            pid = int(response.read(32))
            if pid > 0:
                return pid
    except ConnectionRefusedError:
        return None
    except (ConnectionResetError, TimeoutError, http.client.HTTPException, ValueError):
        pass
    finally:
        client.close()
    raise ValueError(f'Port {port} is occupied by another service. Choose a different --port.')


def start(db, port):
    identity = database_key(db)
    pid = service_at(port, identity)
    if pid:
        return pid
    # Binding is the lock. Concurrent openers can only start one listener.
    command = [sys.executable, __file__, '--serve', '--db', str(db), '--port', str(port)]
    with open(os.devnull, 'r+b') as null:
        child = subprocess.Popen(command, stdin=null, stdout=null, stderr=null, start_new_session=True)
    for _ in range(80):
        pid = service_at(port, identity)
        if pid:
            return pid
        if child.poll() is not None:
            break
        time.sleep(.05)
    raise ValueError('Board failed to start. Run with --serve to see the startup error.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    root = Path(__file__).resolve().parent.parent
    parser.add_argument('project', nargs='?', help='Registered project name (default: infer from current Git checkout)')
    parser.add_argument('--db', default=os.environ.get('LTC_DB', root / '.letthemcook/registry.sqlite3'))
    parser.add_argument('--port', type=int, help='Override the stable registry-specific port')
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--no-open', action='store_true', help='Start or reuse the board and print its URL without opening a browser')
    modes.add_argument('--serve', action='store_true', help='Serve in the foreground until interrupted')
    args = parser.parse_args()
    db = Path(args.db).expanduser().resolve()
    port = args.port if args.port is not None else 16000 + int(database_key(db)[:8], 16) % 16000
    if not 1 <= port <= 65535:
        parser.error('--port must be between 1 and 65535')
    with closing(connect(db)) as conn:
        project = select_project(conn, args.project, Path.cwd())
    if project is None:
        print('No unique registered checkout here. Choose a project on the index or pass its name.', file=sys.stderr)
    path = f"/projects/{project['id']}" if project else '/'
    url = f'http://127.0.0.1:{port}{path}'
    if args.serve:
        try:
            with BoardServer(db, port) as server:
                print(url, flush=True)
                server.serve_forever()
        except OSError as error:
            if error.errno == errno.EADDRINUSE:
                raise ValueError(f'Port {port} is already in use. Omit --serve to reuse a board or choose --port.') from error
            raise
        return
    pid = start(db, port)
    print(url, flush=True)
    print(f'Local board PID {pid}. Stop it with kill {pid}.', file=sys.stderr)
    if not args.no_open and not webbrowser.open(url):
        print('Open the printed URL in a local browser.', file=sys.stderr)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    except (ValueError, sqlite3.Error, OSError) as error:
        sys.exit(f'ltc-tasks: {error}')

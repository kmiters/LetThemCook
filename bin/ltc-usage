#!/usr/bin/env python3
"""Start or reuse the local daily token dashboard and print its URL."""
import argparse
from hashlib import sha256
from http.client import HTTPConnection, HTTPException
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import subprocess
import sys
import time

from ltc_usage import UsageIndex, source_roots

ASSETS = Path(__file__).resolve().parent.parent / 'usage'
ROUTES = {'/': ('index.html', 'text/html'), '/usage.css': ('usage.css', 'text/css'),
          '/usage.js': ('usage.js', 'text/javascript'), '/usage-chart.js': ('usage-chart.js', 'text/javascript'),
          '/fonts/InterVariable.woff2': ('fonts/InterVariable.woff2', 'font/woff2'),
          '/chart-LICENSES.txt': ('chart-LICENSES.txt', 'text/plain'),
          '/marks/openai.svg': ('marks/openai.svg', 'image/svg+xml'), '/marks/claude.svg': ('marks/claude.svg', 'image/svg+xml')}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        if self.headers.get_all('Host') != [f'127.0.0.1:{self.server.server_port}']:
            self.send_error(403)
            return
        if self.path == '/favicon.ico':
            self.send_response(204)
            self.end_headers()
            return
        if self.path == '/health':
            body, mime = str(os.getpid()).encode(), 'text/plain'
        elif self.path == '/api/usage':
            body, mime = json.dumps(self.server.index.snapshot(), separators=(',', ':')).encode(), 'application/json'
        elif self.path in ROUTES:
            name, mime = ROUTES[self.path]
            body = (ASSETS / name).read_bytes()
        else:
            self.send_error(404, 'Not found')
            return
        self.send_response(200)
        if self.path == '/health':
            self.send_header('X-LTC-Usage', self.server.identity)
        self.send_header('Content-Type', mime + '; charset=utf-8' if mime.startswith(('text/', 'application/json')) else mime)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Content-Security-Policy', "default-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'")
        self.end_headers()
        self.wfile.write(body)


def listener(port, identity):
    client = HTTPConnection('127.0.0.1', port, timeout=2)
    try:
        client.request('GET', '/health')
        response = client.getresponse()
        if response.status == 200 and response.getheader('X-LTC-Usage') == identity:
            return int(response.read(32))
    except ConnectionRefusedError:
        return None
    except (TimeoutError, HTTPException, ConnectionResetError, ValueError):
        pass
    finally:
        client.close()
    raise ValueError(f'Port {port} is occupied. Choose a free --port and reuse it for this link.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=30169, help='Stable loopback port (default 30169)')
    parser.add_argument('--serve', action='store_true', help='Keep the listener in the foreground')
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error('port must be between 1 and 65535')
    roots = source_roots()
    paths = [Path(__file__).resolve(), *(p.resolve() for group in roots.values() for p in group)]
    identity = sha256(os.fsencode(os.pathsep.join(map(str, paths)))).hexdigest()
    url = f'http://127.0.0.1:{args.port}/'
    if args.serve:
        with ThreadingHTTPServer(('127.0.0.1', args.port), Handler) as server:
            server.index = UsageIndex(roots)
            server.identity = identity
            print(url, flush=True)
            server.serve_forever()
        return
    pid = listener(args.port, identity)
    if not pid:
        child = subprocess.Popen([sys.executable, str(paths[0]), '--serve', '--port', str(args.port)],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(80):
            pid = listener(args.port, identity)
            if pid or child.poll() is not None:
                break
            time.sleep(.05)
        if not pid:
            raise ValueError('Dashboard failed to start. Use --serve to see the startup error.')
    print(url)
    print(f'Local usage dashboard PID {pid}.', file=sys.stderr)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    except (OSError, ValueError) as error:
        sys.exit(f'ltc-usage: {error}')

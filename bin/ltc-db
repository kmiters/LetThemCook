#!/usr/bin/env python3
"""Manage the Chef's local project and task registry."""
import argparse
import json
import os
from pathlib import Path
import sqlite3
import subprocess
import sys

from ltc_workspace import check_single_checkout, ensure_members, members_for, workspace_checkouts
from ltc_registry import (BRIEF_FIELDS, ensure_briefs, ensure_runs,
                          ensure_task_status_events, get_brief, task_reports)

ROOT = Path(__file__).resolve().parent.parent
STATUSES = ('todo', 'in_progress', 'blocked', 'done', 'cancelled')


def nonempty(value):
    if not value.strip():
        raise argparse.ArgumentTypeError('must not be empty')
    return value.strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--db', default=os.environ.get('LTC_DB', str(ROOT / '.letthemcook' / 'registry.sqlite3')), help='Database path (or LTC_DB)')
    commands = parser.add_subparsers(dest='command', required=True)
    project = commands.add_parser('project').add_subparsers(dest='action', required=True)
    p = project.add_parser('add')
    p.add_argument('name', type=nonempty)
    p.add_argument('path', help='Git checkout or workspace directory')
    p.add_argument('--member', action='append', metavar='NAME', help='Register a direct child Git checkout (repeat for each workspace member)')
    p.add_argument('--description', default='')
    p.add_argument('--space', help='Herdr Space ID')
    p.add_argument('--chef-harness', choices=('codex', 'claude'))
    project.add_parser('list')
    p = project.add_parser('show')
    p.add_argument('name')
    p = project.add_parser('update')
    p.add_argument('name')
    p.add_argument('--path')
    p.add_argument('--space', help='Herdr Space ID')
    p.add_argument('--chef-harness', choices=('codex', 'claude'))
    p.add_argument('--description')
    task = commands.add_parser('task').add_subparsers(dest='action', required=True)
    p = task.add_parser('add')
    p.add_argument('project')
    p.add_argument('title', type=nonempty)
    p.add_argument('--member', help='Target repository name (required for workspace tasks)')
    p.add_argument('--description', default='')
    for field in BRIEF_FIELDS:
        p.add_argument('--' + field)
    p = task.add_parser('list')
    p.add_argument('--project')
    p.add_argument('--status', choices=STATUSES)
    p = task.add_parser('show')
    p.add_argument('id', type=int)
    p = task.add_parser('update')
    p.add_argument('id', type=int)
    p.add_argument('--title', type=nonempty)
    p.add_argument('--description')
    p.add_argument('--status', choices=STATUSES)
    for field in BRIEF_FIELDS:
        p.add_argument('--' + field)
    runs = commands.add_parser('run').add_subparsers(dest='action', required=True)
    p = runs.add_parser('list')
    p.add_argument('--project')
    p.add_argument('--task', type=int)
    p = runs.add_parser('show')
    p.add_argument('id', type=int)
    args = parser.parse_args()

    db = Path(args.db).expanduser().resolve()
    db.parent.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(db, timeout=10) as conn:
        conn.row_factory = sqlite3.Row
        conn.execute('PRAGMA foreign_keys = ON')
        conn.executescript('''
        CREATE TABLE IF NOT EXISTS projects (
            id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, path TEXT NOT NULL UNIQUE,
            description TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        );
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY, project_id INTEGER NOT NULL REFERENCES projects(id),
            title TEXT NOT NULL, description TEXT NOT NULL DEFAULT '',
            status TEXT NOT NULL DEFAULT 'todo' CHECK(status IN ('todo','in_progress','blocked','done','cancelled')),
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        );
        ''')
        conn.execute('BEGIN IMMEDIATE')
        columns = {row['name'] for row in conn.execute('PRAGMA table_info(projects)')}
        if 'space' not in columns:
            conn.execute('ALTER TABLE projects ADD COLUMN space TEXT')
        if 'chef_harness' not in columns:
            conn.execute("ALTER TABLE projects ADD COLUMN chef_harness TEXT NOT NULL DEFAULT 'codex'")
        conn.execute('CREATE UNIQUE INDEX IF NOT EXISTS projects_space ON projects(space)')
        ensure_runs(conn)
        ensure_briefs(conn)
        ensure_task_status_events(conn)
        ensure_members(conn)

        def project_id(name):
            row = conn.execute('SELECT id FROM projects WHERE name = ?', (name,)).fetchone()
            if row is None:
                raise ValueError(f'Project not found: {name}')
            return row['id']

        def project_info(row):
            project = dict(row)
            project['members'] = members_for(conn, project['id'])
            return project

        task_query = """SELECT tasks.*, projects.name AS project, m.name AS member
            FROM tasks JOIN projects ON projects.id = tasks.project_id
            LEFT JOIN project_members m ON m.id = tasks.member_id"""

        def task_row(task_id):
            row = conn.execute(task_query + ' WHERE tasks.id = ?', (task_id,)).fetchone()
            if row is None:
                raise ValueError(f'Task not found: {task_id}')
            task = dict(row)
            task['brief'] = get_brief(conn, task_id)
            task['reports'] = task_reports(conn, task['project_id'], task_id)
            return task

        def update_brief(task_id, fields):
            if not fields:
                return
            conn.execute('INSERT OR IGNORE INTO task_briefs (task_id) VALUES (?)', (task_id,))
            conn.execute('UPDATE task_briefs SET ' + ', '.join(key + ' = ?' for key in fields) + ' WHERE task_id = ?', (*fields.values(), task_id))

        if args.command == 'project':
            if args.action == 'add':
                if args.member:
                    path, members = workspace_checkouts(conn, args.path, args.member)
                else:
                    path, members = check_single_checkout(conn, args.path), []
                inserted = conn.execute('INSERT INTO projects (name, path, description, space, chef_harness) VALUES (?, ?, ?, ?, ?)', (args.name, path, args.description, nonempty(args.space) if args.space is not None else None, args.chef_harness or 'codex'))
                conn.executemany('INSERT INTO project_members (project_id, name, path, common_dir) VALUES (?, ?, ?, ?)',
                                 [(inserted.lastrowid, *member) for member in members])
                result = project_info(conn.execute('SELECT * FROM projects WHERE name = ?', (args.name,)).fetchone())
            elif args.action == 'list':
                result = [project_info(row) for row in conn.execute('SELECT * FROM projects ORDER BY name')]
            elif args.action == 'show':
                project_id(args.name)
                result = project_info(conn.execute('SELECT * FROM projects WHERE name = ?', (args.name,)).fetchone())
            else:
                project_id(args.name)
                updates = {k: getattr(args, k) for k in ('path', 'description', 'space', 'chef_harness') if getattr(args, k) is not None}
                if not updates:
                    raise ValueError('Specify --path, --space, --description or --chef-harness')
                if 'path' in updates:
                    if members_for(conn, project_id(args.name)):
                        raise ValueError('Workspace roots and member paths are fixed at registration')
                    updates['path'] = check_single_checkout(conn, updates['path'])
                if 'space' in updates:
                    updates['space'] = nonempty(updates['space'])
                conn.execute('UPDATE projects SET ' + ', '.join(k + ' = ?' for k in updates) + ', updated_at = CURRENT_TIMESTAMP WHERE name = ?', (*updates.values(), args.name))
                result = project_info(conn.execute('SELECT * FROM projects WHERE name = ?', (args.name,)).fetchone())
        elif args.command == 'run':
            query = '''SELECT cook_runs.*, projects.name AS project, m.name AS member FROM cook_runs
                JOIN projects ON projects.id = cook_runs.project_id LEFT JOIN project_members m ON m.id = cook_runs.member_id'''
            if args.action == 'show':
                row = conn.execute(query + ' WHERE cook_runs.id = ?', (args.id,)).fetchone()
                if row is None:
                    raise ValueError(f'Run not found: {args.id}')
                result = dict(row)
            else:
                where, values = [], []
                if args.project:
                    where.append('cook_runs.project_id = ?')
                    values.append(project_id(args.project))
                if args.task is not None:
                    task_row(args.task)
                    where.append('cook_runs.task_id = ?')
                    values.append(args.task)
                result = [dict(row) for row in conn.execute(query + (' WHERE ' + ' AND '.join(where) if where else '') + ' ORDER BY cook_runs.id', values)]
        elif args.action == 'add':
            pid = project_id(args.project)
            members = members_for(conn, pid)
            member_id = next((m['id'] for m in members if m['name'] == args.member), None)
            if members and member_id is None:
                raise ValueError('Select a registered repository with --member: ' + ', '.join(m['name'] for m in members))
            if not members and args.member is not None:
                raise ValueError('--member is only valid for a workspace')
            cur = conn.execute('INSERT INTO tasks (project_id, title, description, member_id) VALUES (?, ?, ?, ?)',
                               (pid, args.title, args.description, member_id))
            update_brief(cur.lastrowid, {key: getattr(args, key) for key in BRIEF_FIELDS if getattr(args, key) is not None})
            result = task_row(cur.lastrowid)
        elif args.action == 'list':
            where, values = [], []
            if args.project:
                values.append(project_id(args.project))
                where.append('tasks.project_id = ?')
            if args.status:
                values.append(args.status)
                where.append('tasks.status = ?')
            result = [dict(row) for row in conn.execute(task_query + (' WHERE ' + ' AND '.join(where) if where else '') + ' ORDER BY tasks.id', values)]
        elif args.action == 'show':
            result = task_row(args.id)
        else:
            existing_task = task_row(args.id)
            updates = {k: getattr(args, k) for k in ('title', 'description', 'status') if getattr(args, k) is not None}
            brief_updates = {key: getattr(args, key) for key in BRIEF_FIELDS if getattr(args, key) is not None}
            if not updates and not brief_updates:
                raise ValueError('Specify a task or brief field to update')
            assignment = ', '.join(k + ' = ?' for k in updates)
            conn.execute('UPDATE tasks SET ' + (assignment + ', ' if assignment else '') + 'updated_at = CURRENT_TIMESTAMP WHERE id = ?', (*updates.values(), args.id))
            if updates.get('status') == 'done' and existing_task['status'] != 'done':
                conn.execute('INSERT INTO task_status_events(project_id, task_id, from_status, to_status) VALUES (?, ?, ?, ?)',
                             (existing_task['project_id'], args.id, existing_task['status'], 'done'))
            update_brief(args.id, brief_updates)
            result = task_row(args.id)
        print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, sqlite3.Error, subprocess.CalledProcessError) as error:
        print(f'ltc-db: {error}', file=sys.stderr)
        sys.exit(1)

#!/usr/bin/env bash
# Register a checkout and start its Chef in the selected Herdr Space.
set -euo pipefail
if [ "$#" -lt 3 ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: ltc-project NAME CHECKOUT SPACE_ID [DESCRIPTION] [--member NAME ...]" >&2
  exit 2
fi
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
name="$1"
checkout="$2"
space="$3"
shift 3
description=""
if [ "$#" -gt 0 ] && [ "$1" != "--member" ]; then
  description="$1"
  shift
fi
register_args=(project add "$name" "$checkout" --space "$space" --description "$description")
while [ "$#" -gt 0 ]; do
  if [ "$1" != "--member" ] || [ "$#" -lt 2 ]; then
    echo "Expected --member NAME" >&2
    exit 2
  fi
  register_args+=("--member" "$2")
  shift 2
done
"$root/bin/ltc-db" "${register_args[@]}"
if ! "$root/bin/ltc-chef" "$name"; then
  echo "Project was registered, but Chef did not start. Fix the error and retry: $root/bin/ltc-chef $name" >&2
  exit 1
fi

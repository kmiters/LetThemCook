#!/usr/bin/env python3
"""Create an isolated Cook worktree and launch it in Herdr Desktop."""
import argparse
from dataclasses import asdict
import json
import os
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

from ltc_endpoint import verify_callback
from ltc_harness import EFFORTS, resolve_route
from ltc_workspace import check_member_worktree, checked_member_path, member_for_task, member_prompt
from ltc_registry import connect, ensure_runs, start_run, terminal_name

ROOT = Path(__file__).resolve().parent.parent


def run(argv, cwd=None):
    return subprocess.run(argv, cwd=cwd, text=True, capture_output=True, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--project', required=True, help='Project Git checkout')
    parser.add_argument('--space', required=True, help='Herdr Desktop space ID')
    parser.add_argument('--name', required=True, help='Unique task name')
    parser.add_argument('--harness', choices=EFFORTS, help='Cook CLI (default from config, otherwise codex)')
    parser.add_argument('--profile', help='Configured Cook model profile')
    parser.add_argument('--task', required=True, help='Self-contained task brief')
    parser.add_argument('--base', default='HEAD', help='Committed base (default: HEAD)')
    parser.add_argument('--chef', help='Chef terminal address for Cook reports (defaults to HC_TERMINAL_ID)')
    parser.add_argument('--task-id', type=int, help='Registry task ID for recording this launch')
    parser.add_argument('--db', default=os.environ.get('LTC_DB', str(ROOT / '.letthemcook' / 'registry.sqlite3')), help='Registry database')
    parser.add_argument('--config', default=str(ROOT / 'config.json'), help='JSON configuration')
    args = parser.parse_args()
    if not re.fullmatch(r'[a-z0-9_-]{1,32}', args.name) or not re.fullmatch(r'[a-zA-Z0-9_-]+', args.space) or not args.task.strip():
        parser.error('Invalid name, space or empty task')

    config_path = Path(args.config).resolve()
    config = json.loads(config_path.read_text())
    route = resolve_route(config, args.profile or config['default_profile'],
                          args.harness or config.get('default_harness', 'codex'))
    cook_prompt = (config_path.parent / config['prompts']['cook']).resolve().read_text()
    project = Path(run(['git', '-C', args.project, 'rev-parse', '--show-toplevel']).stdout.strip()).resolve()
    base = run(['git', '-C', str(project), 'rev-parse', '--verify', '--end-of-options', args.base + '^{commit}']).stdout.strip()
    target = project / '.letthemcook' / 'worktrees' / args.name
    if target.exists() or target.is_symlink():
        raise ValueError(f'Worktree already exists: {target}; inspect it instead of retrying')
    changes = run(['git', '-C', str(project), 'status', '--porcelain']).stdout

    prompt = cook_prompt + '\n\n# Task\n' + args.task + '\n\nYour worktree: ' + str(target)
    conn = None
    run_id = None
    member = None
    if args.task_id is not None:
        db_path = Path(args.db).expanduser().resolve()
        if not db_path.is_file():
            raise ValueError(f'Registry not found: {db_path}')
        conn = connect(db_path)
        conn.execute('BEGIN IMMEDIATE')
        row = conn.execute('SELECT projects.id, projects.path, projects.space, tasks.title, tasks.status FROM tasks JOIN projects ON projects.id = tasks.project_id WHERE tasks.id = ?', (args.task_id,)).fetchone()
        if row is None or row[2] != args.space:
            raise ValueError('Task, project checkout and Space do not match the registry')
        if row[4] in ('done', 'cancelled'):
            raise ValueError('A finished or cancelled task cannot be dispatched')
        ensure_runs(conn)
        member = member_for_task(conn, row[0], args.task_id)
        checkout = checked_member_path(member, row[1]) if member else Path(row[1]).resolve()
        if project != checkout:
            raise ValueError('Task, project checkout and Space do not match the registry')
        if member:
            check_member_worktree(checkout, target)
            prompt += member_prompt(member, row[1])
        prompt += '\nRegistry: ' + str(db_path) + '\nLetThemCook directory: ' + str(ROOT)
        args.chef = args.chef or os.environ.get('HC_TERMINAL_ID')
        if args.chef:
            verify_callback(conn, row[0], args.chef)
    elif args.chef:
        raise ValueError('A Chef callback requires a registered --task-id')
    if args.chef:
        prompt += '\nReport the outcome or blocker to the Chef using hc send ' + args.chef + '. This is the verified return address supplied by the launcher.'
    harness_cmd = route.command(prompt)
    if conn is not None:
        run_id = start_run(conn, args.task_id, row[0], args.space, target, base,
                           os.environ.get('HC_SESSION') or 'default', args.name, route)
        if member:
            conn.execute('UPDATE cook_runs SET member_id = ? WHERE id = ?', (member['id'], run_id))
        conn.commit()

    def record(state, terminal=None, detail=None):
        if conn is not None:
            conn.execute('UPDATE cook_runs SET launch_state = ?, terminal = ?, detail = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?', (state, terminal, detail, run_id))
            conn.commit()

    # Local exclude keeps all nested worktrees out of the main project's Git status.
    try:
        exclude = Path(run(['git', '-C', str(project), 'rev-parse', '--git-path', 'info/exclude']).stdout.strip())
        if not exclude.is_absolute():
            exclude = project / exclude
        exclude.parent.mkdir(parents=True, exist_ok=True)
        existing = exclude.read_text() if exclude.exists() else ''
        rule = '/.letthemcook/'
        if rule not in existing.splitlines():
            with exclude.open('a') as file:
                file.write(('\n' if existing and not existing.endswith('\n') else '') + rule + '\n')
        target.parent.mkdir(parents=True, exist_ok=True)
        run(['git', '-C', str(project), 'worktree', 'add', '--detach', str(target), base])

    except (OSError, subprocess.CalledProcessError) as error:
        record('failed', detail=str(error))
        raise

    display_name = terminal_name(row[3]) if conn is not None else args.name
    cmd = ['hc', 'run', '--bg', '--name', display_name, '--cwd', str(target), '--label', 'herdr.space=' + args.space]
    if conn is not None:
        token = conn.execute('SELECT token FROM registry_identity WHERE id = 1').fetchone()[0]
        cmd += ['--label', 'ltc.registry=' + token, '--label', 'ltc.run=' + str(run_id),
                '--label', 'ltc.task=' + str(args.task_id), '--label', 'ltc.project=' + str(row[0])]
    if member:
        cmd += ['--label', 'ltc.member=' + str(member['id'])]
    if args.chef:
        cmd += ['--parent', args.chef]
    else:
        cmd += ['--no-parent']
    cmd += ['--', *harness_cmd]
    try:
        launched = run(cmd)
    except (subprocess.CalledProcessError, OSError) as error:
        state = 'failed' if isinstance(error, FileNotFoundError) else 'unknown'
        record(state, detail=str(error))
        print(json.dumps({'error': 'launch_failed', 'run_id': run_id, 'worktree': str(target), 'base': base, 'detail': str(error), 'stderr': getattr(error, 'stderr', None)}), file=sys.stderr)
        return 1
    try:
        herdr = json.loads(launched.stdout)
        if not isinstance(herdr, dict) or not isinstance(herdr.get('address'), str) or not herdr['address']:
            raise ValueError('Launch response has no terminal address')
    except (ValueError, TypeError) as error:
        record('unknown', detail=str(error))
        print(json.dumps({'error': 'launch_response_unknown', 'run_id': run_id, 'worktree': str(target), 'detail': str(error), 'response': launched.stdout}), file=sys.stderr)
        return 1
    first_message = herdr.get('first_message')
    state = 'delivery_failed' if isinstance(first_message, dict) and first_message.get('sent') is False else 'started'
    try:
        record(state, terminal=herdr['address'], detail=json.dumps(first_message) if first_message is not None else None)
    except sqlite3.Error as error:
        print(json.dumps({'error': 'registry_update_failed', 'run_id': run_id, 'worktree': str(target), 'herdr': herdr, 'detail': str(error)}), file=sys.stderr)
        return 1
    print(json.dumps({'run_id': run_id, 'worktree': str(target), 'base': base, 'member': member['name'] if member else None, **asdict(route), 'uncommitted_changes_excluded': bool(changes), 'herdr': herdr}))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, KeyError, ValueError, sqlite3.Error, subprocess.SubprocessError) as error:
        print(f'ltc: {error}', file=sys.stderr)
        sys.exit(1)
